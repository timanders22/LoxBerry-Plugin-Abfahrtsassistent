#!/bin/bash
# Abfahrts-Assistent - Deinstallation
#
# LoxBerry entfernt beim Deinstallieren nur die Ordner des Plugins selbst:
# config/plugins/<x>/, data/plugins/<x>/, bin/, templates/ und beide
# webfrontend/-Ordner (gemessen in sbin/plugininstall.pl, purge_installation).
# Was NEBEN diesen Ordnern liegt, bleibt liegen - und genau dorthin gehoert
# alles, was ein Update ueberstehen soll. Beides raeumt dieses Skript ab:
#
#   config/plugins/<x>.backup.json       - die Zweitschrift der Einstellungen
#   data/plugins/<x>.upgrade_sicherung   - die Sicherung waehrend des Updates
#
# Dazu der Zwischenordner /tmp/<x> (Zwischenstaende, Kalenderkopien).
#
# Aufruf: <ZUFALLSKENNUNG> <NAME> <FOLDER> <VERSION> <BASEFOLDER> <TEMPFOLDER>
# ACHTUNG: $1 ist NICHT der Arbeitsordner, sondern eine zehnstellige
# Zufallskennung. Gearbeitet wird deshalb mit $3 und $5.
UN_FOLDER="${3:-abfahrtsassistent}"
UN_BASE="${5:-$LBHOMEDIR}"

# Fail-closed (Regeln/06): sieht die Lage nicht wie ein LoxBerry aus, wird
# nichts geloescht. Bis 1.6.9 genuegte ein beliebiges vorhandenes Verzeichnis.
if [ -z "$UN_BASE" ] || [ ! -d "$UN_BASE/config/plugins" ] || [ ! -f "$UN_BASE/config/system/general.json" ]; then
    echo "<WARNING> Kein LoxBerry-Wurzelverzeichnis erkannt ('$UN_BASE') - nichts abgeraeumt."
    echo "<WARNING> Von Hand nachsehen: config/plugins/$UN_FOLDER.backup.json (traegt Zugangsdaten)."
    exit 0
fi
# Der Ordnername darf keinen Pfadtrenner tragen, sonst griffe rm daneben.
case "$UN_FOLDER" in
    ''|*/*|*..*) echo "<WARNING> Unzulaessiger Ordnername '$UN_FOLDER' - nichts abgeraeumt."; exit 0 ;;
esac

# Jede Stelle wird nachgezaehlt und einzeln gemeldet: entfernt, war nicht da,
# oder konnte nicht entfernt werden. Bis 1.6.9 stand "<OK> ... entfernt"
# unbedingt da, auch wenn rm gescheitert war - und die Zweitschrift traegt
# den Schluessel des Kartendienstes und das Merkwort.
entferne() {
    ziel="$1"
    if [ ! -e "$ziel" ]; then
        echo "<INFO> War nicht vorhanden: $ziel"
        return 0
    fi
    rm -rf "$ziel" 2>/dev/null
    if [ -e "$ziel" ]; then
        echo "<WARNING> Konnte nicht entfernt werden: $ziel"
        return 1
    fi
    echo "<OK> Entfernt: $ziel"
    return 0
}

# Die zurueckbehaltenen MQTT-Themen der Linie leeren - VOR dem Loeschen, denn
# das Praefix steht in der Konfiguration. Bis 1.6.12 blieben OK, FEHLER, AUDIO
# und PUSH (von 1.6.8 bis 1.6.12 retained gesendet) nach dem Deinstallieren im
# Broker stehen, und nach jedem Neustart von Broker oder Gateway bekam der
# Miniserver sie wieder - von einem Plugin, das es nicht mehr gibt (in WSL
# gemessen, Pruefung-Abfahrtsassistent-1.6.13, Faelle U1 bis U7). Geleert wird
# ueber den Weg der Linie, den UDP-Eingang des Gateways, und beim Broker
# nachgelesen (abfahrt_mqtt_leeren() in webfrontend/html/abfahrt_lib.php;
# Bauart AWM-Abfuhr 1.4.13). Als loxberry, nicht als root; stdin geschlossen,
# damit su nie auf eine Eingabe wartet.
UN_DIENST="$UN_BASE/bin/plugins/$UN_FOLDER/abfahrt_dienst.php"
if command -v php >/dev/null 2>&1 && [ -f "$UN_DIENST" ]; then
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "$(printf '%q ' env "LBHOMEDIR=$UN_BASE" "LBPPLUGINDIR=$UN_FOLDER" \
            timeout 120 php "$UN_DIENST" --mqtt-leeren)" < /dev/null 2>&1 || true
    else
        env "LBHOMEDIR=$UN_BASE" "LBPPLUGINDIR=$UN_FOLDER" timeout 120 php "$UN_DIENST" --mqtt-leeren \
            < /dev/null 2>&1 || true
    fi
else
    echo "<INFO> PHP oder $UN_DIENST fehlt - zurueckbehaltene MQTT-Themen wurden nicht geleert."
fi

entferne "$UN_BASE/config/plugins/$UN_FOLDER.backup.json"
entferne "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung"
entferne "/tmp/$UN_FOLDER"
exit 0
