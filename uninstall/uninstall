#!/bin/bash
# Abfahrts-Assistent - Deinstallation
#
# LoxBerry entfernt beim Deinstallieren nur die Ordner des Plugins selbst:
# config/plugins/<x>/, data/plugins/<x>/, bin/, templates/ und beide
# webfrontend/-Ordner (gemessen in sbin/plugininstall.pl, purge_installation).
# Was NEBEN diesen Ordnern liegt, bleibt liegen - und genau dorthin gehoert
# alles, was ein Update ueberstehen soll. Beides raeumt dieses Skript ab:
#
#   config/plugins/<x>.backup.json       - die Zweitschrift der Einstellungen
#   data/plugins/<x>.upgrade_sicherung   - die Sicherung waehrend des Updates
#
# Seit 1.6.16 (I1, Entscheidung 1) dazu, nur wenn vorhanden:
#   config/plugins/<x>.backup.json.alt, data/plugins/<x>.upgrade_sicherung.alt
#                                        - bei einer Neuinstallation beiseitegelegt
#   data/plugins/<x>.upgrade_sicherung.neu - eine halb gebaute Sicherung
#   data/plugins/<x>.upgrade_laeuft        - die Marke eines abgebrochenen Updates
#   config/plugins/<x>.backup.json.*.neu   - Nebendatei eines abgebrochenen Schreibens
#                                            (bis 1.6.15 blieb sie liegen, Fall G2)
#
# Dazu der Zwischenordner /tmp/<x> (Zwischenstaende, Kalenderkopien).
#
# Aufruf: <ZUFALLSKENNUNG> <NAME> <FOLDER> <VERSION> <BASEFOLDER> <TEMPFOLDER>
# ACHTUNG: $1 ist NICHT der Arbeitsordner, sondern eine zehnstellige
# Zufallskennung. Gearbeitet wird deshalb mit $3 und $5.
# Gruppe 2 / MQTT (1.6.30; Entwurf aa E13): plugininstall.pl ruft beim Deinstallieren jedes
# data/system/uninstall/$pname* und gibt als $2 den NAMEN des deinstallierten Plugins (am Geraet gemessen
# 08.10.2026: zigbee2mqtt riss so zigbee2mqttng mit). Traegt ein anderes Plugin einen Namen, der mit
# "abfahrtsassistent" beginnt, liefe dieses Skript mit - seit 1.6.30 hielte es dabei auch die Befehlsbruecke
# an und loeschte ihre Zugangsdaten. Deshalb: $2 gesetzt und nicht der eigene Name -> nichts tun.
if [ -n "$2" ] && [ "$2" != "abfahrtsassistent" ]; then
    echo "<INFO> Deinstallation von '$2' - dieses Skript gehoert zu abfahrtsassistent und tut nichts."
    exit 0
fi
UN_FOLDER="${3:-abfahrtsassistent}"
UN_BASE="${5:-$LBHOMEDIR}"

# Fail-closed (Regeln/06): sieht die Lage nicht wie ein LoxBerry aus, wird
# nichts geloescht. Bis 1.6.9 genuegte ein beliebiges vorhandenes Verzeichnis.
if [ -z "$UN_BASE" ] || [ ! -d "$UN_BASE/config/plugins" ] || [ ! -f "$UN_BASE/config/system/general.json" ]; then
    echo "<WARNING> Kein LoxBerry-Wurzelverzeichnis erkannt ('$UN_BASE') - nichts abgeraeumt."
    echo "<WARNING> Von Hand nachsehen: config/plugins/$UN_FOLDER.backup.json (traegt Zugangsdaten)."
    exit 0
fi
# Der Ordnername darf keinen Pfadtrenner tragen, sonst griffe rm daneben.
case "$UN_FOLDER" in
    ''|*/*|*..*) echo "<WARNING> Unzulaessiger Ordnername '$UN_FOLDER' - nichts abgeraeumt."; exit 0 ;;
esac

# Jede Stelle wird nachgezaehlt und einzeln gemeldet: entfernt, war nicht da,
# oder konnte nicht entfernt werden. Bis 1.6.9 stand "<OK> ... entfernt"
# unbedingt da, auch wenn rm gescheitert war - und die Zweitschrift traegt
# den Schluessel des Kartendienstes und das Merkwort.
entferne() {
    ziel="$1"
    if [ ! -e "$ziel" ]; then
        echo "<INFO> War nicht vorhanden: $ziel"
        return 0
    fi
    rm -rf "$ziel" 2>/dev/null
    if [ -e "$ziel" ]; then
        echo "<WARNING> Konnte nicht entfernt werden: $ziel"
        return 1
    fi
    echo "<OK> Entfernt: $ziel"
    return 0
}

# Einen laufenden Lauf des Dienstes abwarten (Pruefung 02.10.2026, Nr. 22).
# Er haelt die Sperre bis zu gut 40 s (Lebenszeichen 5 bis 40 s nach dem
# Start) und legte bis 1.6.21 nach dem Abraeumen /tmp/<ordner> wieder an und
# sendete noch ein Lebenszeichen. flock(1) nimmt dieselbe flock(2)-Sperre wie
# PHPs flock() im Dienst (abfahrt_sperre()); gewartet wird hoechstens 90 s.
# Zwei Orte: der Zwischenordner und sein Ersatz unter data/ (abfahrt_tmpdir()).
for UN_SPERRE in "/tmp/$UN_FOLDER/dienst.lock" "$UN_BASE/data/plugins/$UN_FOLDER/tmp/dienst.lock"; do
    [ -f "$UN_SPERRE" ] && [ ! -L "$UN_SPERRE" ] || continue
    if ! command -v flock >/dev/null 2>&1; then
        echo "<INFO> flock fehlt - ein eventuell laufender Lauf des Dienstes wurde nicht abgewartet."
        break
    fi
    if flock -n "$UN_SPERRE" true 2>/dev/null; then
        continue
    fi
    echo "<INFO> Ein Lauf des Dienstes rechnet noch - warte bis zu 90 s auf sein Ende."
    if flock -w 90 "$UN_SPERRE" true 2>/dev/null; then
        echo "<OK> Der laufende Lauf des Dienstes ist beendet."
    else
        echo "<WARNING> Der Lauf des Dienstes hielt die Sperre nach 90 s noch ($UN_SPERRE) - er kann den Zwischenordner nach dem Abraeumen wieder anlegen."
    fi
done

# ---------- Gruppe 2 / MQTT (1.6.30): die Befehlsbruecke anhalten und abraeumen ----------
# Bauart vb_g1_bruecke_bau/beispiel/uninstall/uninstall (Entwurf gemeinsam 2.9): stop beendet Dienst und
# mosquitto_sub; danach argumentweise nachzaehlen (argv[0] php, argv[1] genau der Dienstpfad, kein argv[2])
# und verwaiste mosquitto_sub mit UNSERER Optionsdatei beenden; die Optionsdateien (Broker-Kennwort)
# ueberschreiben und den Ordner befehle/ entfernen; nachzaehlen. VOR dem Leeren der Themen, damit kein Befehl
# mehr dazwischenkommt. Lage und Ordnername sind oben schon geprueft (fail-closed).
BBSH="$UN_BASE/bin/plugins/$UN_FOLDER/befehlsbruecke.sh"
BBPHP="$UN_BASE/bin/plugins/$UN_FOLDER/befehlsbruecke.php"
BBDIR="$UN_BASE/data/plugins/$UN_FOLDER/befehle"
if [ -f "$BBSH" ]; then
    timeout 40 bash "$BBSH" stop 2>&1 | sed 's/^/<INFO> /'
fi
bb_rest=0
for d in /proc/[0-9]*; do
    mapfile -d '' -t a 2>/dev/null < "$d/cmdline" || continue
    if [ "${#a[@]}" -eq 2 ] && [ "${a[1]}" = "$BBPHP" ] && [[ "${a[0]}" =~ (^|/)php[0-9.]*$ ]]; then
        kill -9 "${d#/proc/}" 2>/dev/null
        bb_rest=$((bb_rest + 1))
    fi
done
bb_abos=0
for d in /proc/[0-9]*; do
    read -r c 2>/dev/null < "$d/comm" || continue
    [ "$c" = "mosquitto_sub" ] || continue
    mapfile -d '' -t e 2>/dev/null < "$d/environ" || continue
    for x in "${e[@]}"; do
        if [ "$x" = "XDG_CONFIG_HOME=$BBDIR/mosquitto" ]; then kill -9 "${d#/proc/}" 2>/dev/null; bb_abos=$((bb_abos + 1)); fi
    done
done
[ "$bb_rest" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $bb_rest Dienst(e) erst mit kill -9 beendet."
[ "$bb_abos" -gt 0 ] && echo "<WARNING> Befehlsbruecke: $bb_abos mosquitto_sub erst mit kill -9 beendet."
if [ -d "$BBDIR" ]; then
    for f in "$BBDIR/mosquitto/mosquitto_sub" "$BBDIR/mosquitto/mosquitto_pub"; do
        if [ -f "$f" ]; then
            n=$(stat -c %s "$f" 2>/dev/null || echo 64)
            head -c "$n" /dev/zero > "$f" 2>/dev/null
        fi
    done
    rm -rf "${BBDIR:?}"
    if [ -e "$BBDIR/mosquitto/mosquitto_sub" ] || [ -e "$BBDIR/mosquitto/mosquitto_pub" ]; then
        echo "<WARNING> Befehlsbruecke: Optionsdateien liegen noch unter $BBDIR/mosquitto - von Hand entfernen."
    else
        echo "<OK> Befehlsbruecke angehalten, Zugangsdaten der Befehlsbruecke entfernt."
    fi
fi

# Die zurueckbehaltenen MQTT-Themen der Linie leeren - VOR dem Loeschen, denn
# das Praefix steht in der Konfiguration. Bis 1.6.12 blieben OK, FEHLER, AUDIO
# und PUSH (von 1.6.8 bis 1.6.12 retained gesendet) nach dem Deinstallieren im
# Broker stehen, und nach jedem Neustart von Broker oder Gateway bekam der
# Miniserver sie wieder - von einem Plugin, das es nicht mehr gibt (in WSL
# gemessen, Pruefung-Abfahrtsassistent-1.6.13, Faelle U1 bis U7). Geleert wird
# ueber den Weg der Linie, den UDP-Eingang des Gateways, und beim Broker
# nachgelesen (abfahrt_mqtt_leeren() in webfrontend/html/abfahrt_lib.php;
# Bauart AWM-Abfuhr 1.4.13). Als loxberry, nicht als root; stdin geschlossen,
# damit su nie auf eine Eingabe wartet.
#
# 'timeout -k 5 120': ohne -k schickt timeout nach 120 s nur SIGTERM - ein
# Lauf, der es nicht annimmt, hielt die Deinstallation an, bis er von selbst
# endete, und die Zweitschrift mit den Zugangsdaten (unten) blieb so lange
# liegen. Bis 1.6.14 stand hier 'timeout 120' und dahinter '|| true': ein
# Abbruch erschien in der Ausgabe des Installers gar nicht. Gemessen in WSL
# mit einem SIGTERM-festen Platzhalter an der Stelle von abfahrt_dienst.php
# (Pruefung-Abfahrtsassistent-1.6.15, Faelle K0-K7; Bauart Weissware 0.9.34).
# Rueckgabe 0-2 meldet der Dienst selbst (abfahrt_mqtt_leeren(); 1 auch,
# wenn er seine Bibliothek nicht findet - das steht dann auf stderr).
UN_DIENST="$UN_BASE/bin/plugins/$UN_FOLDER/abfahrt_dienst.php"
if command -v php >/dev/null 2>&1 && [ -f "$UN_DIENST" ]; then
    UN_RC=0
    if [ "$(id -u)" = "0" ] && id loxberry >/dev/null 2>&1; then
        su -s /bin/bash loxberry -c "$(printf '%q ' env "LBHOMEDIR=$UN_BASE" "LBPPLUGINDIR=$UN_FOLDER" \
            timeout -k 5 120 php "$UN_DIENST" --mqtt-leeren)" < /dev/null 2>&1 || UN_RC=$?
    else
        env "LBHOMEDIR=$UN_BASE" "LBPPLUGINDIR=$UN_FOLDER" timeout -k 5 120 php "$UN_DIENST" --mqtt-leeren \
            < /dev/null 2>&1 || UN_RC=$?
    fi
    case "$UN_RC" in
        0|1|2) ;;
        124) echo "<WARNING> MQTT: das Leeren der zurueckbehaltenen Themen wurde nach 120 s abgebrochen - unter dem Praefix der Linie kann noch etwas im Broker stehen. Von Hand: mosquitto_pub -r -n -t <thema>" ;;
        137) echo "<WARNING> MQTT: das Leeren der zurueckbehaltenen Themen reagierte nach 120 s nicht auf SIGTERM und wurde hart beendet (SIGKILL) - unter dem Praefix der Linie kann noch etwas im Broker stehen. Von Hand: mosquitto_pub -r -n -t <thema>" ;;
        *) echo "<WARNING> MQTT: das Leeren der zurueckbehaltenen Themen endete unerwartet (Rueckgabe $UN_RC) - unter dem Praefix der Linie kann noch etwas im Broker stehen." ;;
    esac
else
    echo "<INFO> PHP oder $UN_DIENST fehlt - zurueckbehaltene MQTT-Themen wurden nicht geleert."
fi

entferne "$UN_BASE/config/plugins/$UN_FOLDER.backup.json"
entferne "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung"
entferne "/tmp/$UN_FOLDER"
# I1: nur melden, was da war - eine Neuinstallation ohne Reste soll im
# Protokoll nicht fuenf Zeilen "War nicht vorhanden" bekommen.
entferne_falls() {
    if [ -e "$1" ] || [ -L "$1" ]; then entferne "$1"; fi
    return 0
}
entferne_falls "$UN_BASE/config/plugins/$UN_FOLDER.backup.json.alt"
entferne_falls "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung.alt"
entferne_falls "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_sicherung.neu"
entferne_falls "$UN_BASE/data/plugins/$UN_FOLDER.upgrade_laeuft"
for UN_NEBEN in "$UN_BASE/config/plugins/$UN_FOLDER".backup.json.*.neu; do
    entferne_falls "$UN_NEBEN"
done
exit 0
